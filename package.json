{
  "name": "@duke-dsh-plugins/dsh-git-manager",
  "version": "1.6.2",
  "description": "DSH 正式 bundle 插件：在 DSH Web UI 里管理 Git 工作区——入口在输入框「模式」选择器旁（仅 git 仓库显示），进入与设置同规格的居中面板：变更暂存（hunk 级/行级/stash）、分支与 tag、交互式 rebase、提交历史（分支线图形/过滤/范围对比/revert/reset/fixup/undo）、合并冲突解决、blame/reflog、worktree 管理（添加后自动注册为 DSH 工作区）、remote/config 设置，以及**子仓库支持**（git submodule + 嵌套独立仓库：仓库树发现、变更聚合分组、仓库切换、指针 diff 与冲突解决、submodule 管理与嵌套仓库注册）。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlitDropOfBlood/dsh-git-manager.git"
  },
  "homepage": "https://github.com/MoonlitDropOfBlood/dsh-git-manager",
  "bugs": {
    "url": "https://github.com/MoonlitDropOfBlood/dsh-git-manager/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "git",
    "worktree"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "git-core.mjs",
    "git-graph.mjs",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "^0.1.0-rc.7 || ^0.1.1-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": "^0.1.0-rc.7 || ^0.1.1-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7 || ^0.1.1-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check typert.host.js && node --check git-core.mjs && node --check git-graph.mjs && node --check scripts/self-test.mjs",
    "test": "node scripts/self-test.mjs"
  }
}
